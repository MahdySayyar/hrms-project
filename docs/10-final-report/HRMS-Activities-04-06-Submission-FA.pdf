      max_length: 3000
  rules:
    BR-08: pending_transitions_once_to_approved_or_rejected
    BR-09: rejection_requires_nonblank_notes
    BR-10: reject_overlap_with_same_employee_approved_leave_or_travel
    BR-14: commit_decision_and_audit_in_one_transaction
  success:
    new_decision:
      status: 303
      review_audit_count: 1
    same_decision_retry:
      status: 303
      additional_audit_count: 0
  failure:
    invalid_decision_notes_or_overlap: 400
    unauthorized_role_or_invalid_csrf: 403
    request_missing_or_out_of_scope: 404
    opposite_final_decision_or_invalid_state: 409
    persistence_or_audit_failure: 500
    invariant: preserve_previous_decision_and_review_audit
  acceptance:
    TC-02-02: approve_once_and_write_one_audit
    TC-02-03: reject_blank_rejection_reason
    TC-02-04: same_decision_preserves_original_notes_and_audit
    TC-02-05: opposite_final_decision_conflicts
    TC-02-06: reject_overlap_on_shared_boundary_day
    TC-02-07: two_overlapping_approvals_allow_only_one
    TC-02-08: audit_failure_rolls_back_the_decision
    TC-02-09: accept_3000_characters_and_reject_3001

endstream
